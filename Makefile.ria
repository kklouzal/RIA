# RIA numerical code has an explicit floating-point contract; never inherit
# the donor's fast-math or build-host-specific ISA flags for portable images.
RIA_CC ?= $(CC)
RIA_THREAD_CC ?= clang-18
RIA_NVCC ?= /usr/local/cuda/bin/nvcc
RIA_CUDA_HOME ?= /usr/local/cuda
RIA_PYTHON ?= python3
RIA_CFLAGS ?= -O2 -g -std=c99 -Wall -Wextra -Werror -Wformat=2 -Wstrict-prototypes -fno-fast-math -ffp-contract=off
ifneq ($(origin RIA_CFLAGS),file)
$(error RIA host flags are fixed by the reviewed numerical build contract; edit the owned build recipe to change them)
endif
RIA_CPPFLAGS = -I. -Iria -Ithird_party/ryu -D_FILE_OFFSET_BITS=64
RIA_LDLIBS = -lssl -lcrypto -lnuma -lpthread -lm
RIA_BASE_SRC = ria/common.c ria/json.c ria/protocol.c ria/transport.c ria/admission.c third_party/ryu/ryu/d2s.c
RIA_CORE_SRC = $(RIA_BASE_SRC) ria/expert.c ria/tensor.c ria/state.c ria/bank.c ria/service.c ria/admin.c ria/runtime.c ria/prefill.c ria/remote.c
RIA_CORE_OBJ = $(patsubst %.c,build/ria/%.o,$(RIA_CORE_SRC))
RIA_GRAPH_HOST_SRC = ria/graph.c ria/vision.c ria/engine.c ria/tokenizer.c ria/prompt.c
RIA_GRAPH_HOST_OBJ = $(patsubst %.c,build/ria/%.o,$(RIA_GRAPH_HOST_SRC))
RIA_CUDA_SRC = ria/expert_cuda.cu ria/graph_cuda.cu ria/vision_cuda.cu ria/probe_cuda.cu
RIA_CUDA_OBJ = $(patsubst %.cu,build/ria/%.cu.o,$(RIA_CUDA_SRC))
RIA_NVCCFLAGS = -O2 -g -lineinfo -std=c++17 --compiler-bindir=g++ --generate-code=arch=compute_120a,code=sm_120a --fmad=false --ftz=false --prec-div=true --prec-sqrt=true --Werror=cross-execution-space-call,reorder,deprecated-declarations,default-stream-launch,ext-lambda-captures-this -Xcompiler=-Wall,-Wextra,-Werror,-fno-fast-math,-ffp-contract=off,-pthread
ifneq ($(strip $(NVCC_PREPEND_FLAGS)$(NVCC_APPEND_FLAGS)),)
$(error RIA CUDA compiler environment may not inject unreviewed flags)
endif
ifneq ($(origin RIA_NVCCFLAGS),file)
$(error RIA CUDA flags are fixed by the reviewed numerical and AOT build contract; edit the owned build recipe to change them)
endif
ifneq ($(filter --use_fast_math -use_fast_math --fmad=true -fmad=true --ftz=true -ftz=true --prec-div=false -prec-div=false --prec-sqrt=false -prec-sqrt=false,$(RIA_NVCCFLAGS)),)
$(error RIA CUDA builds require the declared strict floating-point contract)
endif
RIA_FRONTEND_LIBS = -lonig -lpng -ljpeg
# The public DS4 adapter uses the donor's CPU build as its existing host API;
# RIA learned operations always enter the independent native CUDA graph.
RIA_DONOR_SRC = ds4.c ds4_image.c ds4_distributed.c ds4_tp.c ds4_ssd.c ds4_layer_pack.c ds4_engram.c ds4_gpu_args.c ds4_help.c
RIA_DONOR_OBJ = $(patsubst %.c,build/ria/donor/%.o,$(RIA_DONOR_SRC))
RIA_DONOR_FLAGS = -O2 -g -std=c99 -Wall -Wextra -Werror -Wno-unused-function -fno-fast-math -ffp-contract=off -D_GNU_SOURCE -DDS4_NO_GPU -DDS4_RIA
ifneq ($(origin RIA_DONOR_FLAGS),file)
$(error RIA adapter flags are fixed by the reviewed numerical build contract)
endif
RIA_DEPS = $(RIA_CORE_OBJ:.o=.d) $(RIA_GRAPH_HOST_OBJ:.o=.d) $(RIA_DONOR_OBJ:.o=.d) $(wildcard build/ria/ria/*.d build/ria/donor/*.d build/ria/cuda/*.d)

.PHONY: ria-cpu ria-cuda ria-offline ria-static ria-clean
ria-cpu: bin/ds4ctl bin/ds4-expert-server bin/ds4-ria-qualify
ria-cuda: bin/cuda/ds4ctl bin/cuda/ds4-expert-server bin/cuda/ds4-server bin/cuda/ds4 bin/cuda/ds4-eval bin/cuda/ds4-ria-qualify
	$(RIA_PYTHON) deploy/check_cuda_artifacts.py --output build/ria/evidence/cuda-artifacts.json

build/ria/%.o: %.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -MMD -MP -c $< -o $@

build/ria/%.cu.o: %.cu
	@mkdir -p $(@D)
	$(RIA_NVCC) $(RIA_CPPFLAGS) -I$(RIA_CUDA_HOME)/include/cccl $(RIA_NVCCFLAGS) -DRIA_WITH_CUDA -MMD -MP -c $< -o $@

build/ria/cuda/%.o: ria/%.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -DRIA_WITH_CUDA -isystem $(RIA_CUDA_HOME)/include -MMD -MP -c $< -o $@

build/ria/ria/qualify.o: ria/qualify.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -DRIA_QUALIFY_CPU_ONLY -MMD -MP -c $< -o $@

bin/ds4-ria-qualify: build/ria/ria/qualify.o build/ria/ria/expert.o $(patsubst %.c,build/ria/%.o,$(RIA_BASE_SRC))
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CFLAGS) $^ $(RIA_LDLIBS) -o $@

bin/cuda/ds4-ria-qualify: build/ria/cuda/qualify.o build/ria/ria/graph.o build/ria/ria/vision.o build/ria/ria/expert_cuda.cu.o build/ria/ria/graph_cuda.cu.o build/ria/ria/vision_cuda.cu.o $(RIA_CORE_OBJ)
	@mkdir -p $(@D)
	$(RIA_NVCC) $(RIA_NVCCFLAGS) $^ $(RIA_LDLIBS) -lpng -ljpeg -o $@

build/ria/donor/%.o: %.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_DONOR_FLAGS) -MMD -MP -c $< -o $@

bin/ds4ctl: build/ria/ria/ctl.o build/ria/ria/inventory.o build/ria/ria/numa.o build/ria/ria/probe.o build/ria/ria/qualify_transport.o $(RIA_CORE_OBJ)
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CFLAGS) $^ $(RIA_LDLIBS) -o $@

bin/ds4-expert-server: build/ria/ria/expert_main.o build/ria/ria/server.o build/ria/ria/numa.o build/ria/ria/remote.o $(RIA_CORE_OBJ)
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CFLAGS) $^ $(RIA_LDLIBS) -o $@

bin/cuda/ds4ctl: build/ria/ria/ctl.o build/ria/ria/inventory.o build/ria/ria/numa.o build/ria/cuda/probe.o build/ria/ria/qualify_transport.o build/ria/ria/probe_cuda.cu.o build/ria/ria/expert_cuda.cu.o $(RIA_CORE_OBJ)
	@mkdir -p $(@D)
	$(RIA_NVCC) $(RIA_NVCCFLAGS) $^ $(RIA_LDLIBS) -o $@

bin/cuda/ds4-expert-server: build/ria/cuda/expert_main.o build/ria/cuda/server.o build/ria/ria/numa.o build/ria/ria/remote.o build/ria/ria/expert_cuda.cu.o $(RIA_CORE_OBJ)
	@mkdir -p $(@D)
	$(RIA_NVCC) $(RIA_NVCCFLAGS) $^ $(RIA_LDLIBS) -o $@

RIA_FRONTEND_OBJ = $(RIA_GRAPH_HOST_OBJ) $(filter-out build/ria/ria/probe_cuda.cu.o,$(RIA_CUDA_OBJ)) $(RIA_CORE_OBJ) $(RIA_DONOR_OBJ)
bin/cuda/ds4-server: build/ria/donor/ds4_server.o build/ria/donor/ds4_kvstore.o build/ria/donor/rax.o $(RIA_FRONTEND_OBJ)
	@mkdir -p $(@D)
	$(RIA_NVCC) $(RIA_NVCCFLAGS) $^ $(RIA_LDLIBS) $(RIA_FRONTEND_LIBS) -o $@

bin/cuda/ds4: build/ria/donor/ds4_cli.o build/ria/donor/ds4_prompt_prefix.o build/ria/donor/linenoise.o $(RIA_FRONTEND_OBJ)
	@mkdir -p $(@D)
	$(RIA_NVCC) $(RIA_NVCCFLAGS) $^ $(RIA_LDLIBS) $(RIA_FRONTEND_LIBS) -o $@

bin/cuda/ds4-eval: build/ria/donor/ds4_eval.o build/ria/donor/ds4_eval_cases.o $(RIA_FRONTEND_OBJ)
	@mkdir -p $(@D)
	$(RIA_NVCC) $(RIA_NVCCFLAGS) $^ $(RIA_LDLIBS) $(RIA_FRONTEND_LIBS) -o $@

build/ria/tests/test_contracts: tests/ria/test_contracts.c $(RIA_BASE_SRC)
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) $^ $(RIA_LDLIBS) -o $@

build/ria/tests/test_expert: tests/ria/test_expert.c ria/expert.c ria/common.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) $^ $(RIA_LDLIBS) -o $@

build/ria/tests/test_state: tests/ria/test_state.c ria/state.c ria/common.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) $^ $(RIA_LDLIBS) -o $@

build/ria/tests/test_tensor: tests/ria/test_tensor.c $(RIA_CORE_SRC)
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) $^ $(RIA_LDLIBS) -o $@

build/ria/tests/test_graph_contracts: tests/ria/test_graph_contracts.c ria/graph.c ria/vision.c ria/prefill.c ria/expert.c ria/common.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -ffunction-sections $^ -Wl,--gc-sections $(RIA_LDLIBS) -lpng -ljpeg -o $@

build/ria/tests/test_probe_config: tests/ria/test_probe_config.c ria/probe.c ria/runtime.c $(RIA_BASE_SRC)
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) $^ $(RIA_LDLIBS) -o $@

build/ria/tests/test_admin: tests/ria/test_admin.c $(RIA_CORE_SRC)
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) $^ $(RIA_LDLIBS) -o $@

build/ria/tests/test_server_contracts: tests/ria/test_server_contracts.c ria/server.c ria/numa.c $(RIA_CORE_SRC)
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) $^ $(RIA_LDLIBS) -o $@

build/ria/tests/test_server_lifecycle: tests/ria/test_server_lifecycle.c ria/server.c ria/numa.c $(RIA_CORE_SRC)
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) $(filter-out ria/server.c,$^) $(RIA_LDLIBS) -o $@

build/ria/tests/test_graph_prefill: tests/ria/test_graph_prefill.c ria/graph.c ria/prefill.c ria/expert.c ria/common.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -ffunction-sections $(filter-out ria/graph.c,$^) -Wl,--gc-sections -lcrypto -lm -o $@

build/ria/tests/test_engine_prefill: tests/ria/test_engine_prefill.c ria/engine.c ria/common.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -ffunction-sections -fdata-sections $(filter-out ria/engine.c,$^) -Wl,--gc-sections -lcrypto -lpthread -lm -o $@

RIA_ENGINE_STARTUP_FIXTURE_SRC = tests/ria/test_engine_startup.c ria/common.c ria/json.c third_party/ryu/ryu/d2s.c
build/ria/tests/test_engine_startup: $(RIA_ENGINE_STARTUP_FIXTURE_SRC) ria/engine.c ria/engine.h ds4.h
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -ffunction-sections -fdata-sections $(RIA_ENGINE_STARTUP_FIXTURE_SRC) -Wl,--gc-sections -lcrypto -lpthread -lm -o $@

RIA_API_POLICY_FIXTURE_SRC = tests/ria/test_api_policy.c ria/engine.c ria/service.c ria/json.c ria/common.c third_party/ryu/ryu/d2s.c
build/ria/tests/test_api_policy: $(RIA_API_POLICY_FIXTURE_SRC) ds4_server.c ria/engine.h ds4.h
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -Wno-unused-function -ffunction-sections -fdata-sections $(RIA_API_POLICY_FIXTURE_SRC) -Wl,--gc-sections -lcrypto -lpthread -lm -o $@

RIA_TENSOR_METADATA_FIXTURE_SRC = tests/ria/test_tensor_metadata.c ria/json.c ria/common.c third_party/ryu/ryu/d2s.c
build/ria/tests/test_tensor_metadata: $(RIA_TENSOR_METADATA_FIXTURE_SRC) ria/tensor.c ria/tensor.h
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -ffunction-sections -fdata-sections $(RIA_TENSOR_METADATA_FIXTURE_SRC) -Wl,--gc-sections -lcrypto -lnuma -lm -o $@

RIA_TOKENIZER_BOUNDARY_FIXTURE_SRC = tests/ria/test_tokenizer_boundary.c ria/tokenizer.c ria/json.c ria/common.c third_party/ryu/ryu/d2s.c
RIA_TOKENIZER_BOUNDARY_LDFLAGS = -Wl,--gc-sections -Wl,--wrap=read -Wl,--wrap=__read_chk -lonig -lcrypto -lpthread -lm
build/ria/tests/test_tokenizer_boundary: $(RIA_TOKENIZER_BOUNDARY_FIXTURE_SRC) ria/tokenizer.h
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -ffunction-sections -fdata-sections $(RIA_TOKENIZER_BOUNDARY_FIXTURE_SRC) $(RIA_TOKENIZER_BOUNDARY_LDFLAGS) -o $@

build/ria/tests/test_server_prefill: tests/ria/test_server_prefill.c ria/server.c ria/expert.c ria/common.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -ffunction-sections $(filter-out ria/server.c,$^) -Wl,--gc-sections -lcrypto -lpthread -lm -o $@

RIA_FRONTEND_FIXTURE_SRC = tests/ria/test_frontend_contracts.c ria/engine.c ria/tokenizer.c ria/prompt.c ria/json.c ria/common.c third_party/ryu/ryu/d2s.c
build/ria/tests/test_frontend_contracts: $(RIA_FRONTEND_FIXTURE_SRC)
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -ffunction-sections -fdata-sections $^ -Wl,--gc-sections -lonig -lcrypto -lm -lpthread -o $@

build/ria/tests/test_measurements: tests/ria/test_measurements.c ds4_server.c ria/common.c
	@mkdir -p $(@D)
	$(RIA_CC) $(RIA_CPPFLAGS) -O2 -g -std=c99 -Wall -Wextra -Werror -Wno-unused-function -fno-fast-math -ffp-contract=off -ffunction-sections -fdata-sections tests/ria/test_measurements.c ria/common.c -Wl,--gc-sections -lm -lpthread -lcrypto -o $@

ria-offline: build/ria/tests/test_tokenizer_boundary build/ria/tests/test_api_policy build/ria/tests/test_tensor_metadata build/ria/tests/test_engine_startup build/ria/tests/test_engine_prefill build/ria/tests/test_server_prefill build/ria/tests/test_graph_prefill build/ria/tests/test_measurements bin/ds4ctl bin/ds4-ria-qualify build/ria/tests/test_contracts build/ria/tests/test_expert build/ria/tests/test_state build/ria/tests/test_tensor build/ria/tests/test_graph_contracts build/ria/tests/test_probe_config build/ria/tests/test_admin build/ria/tests/test_frontend_contracts build/ria/tests/test_server_contracts build/ria/tests/test_server_lifecycle
	build/ria/tests/test_contracts
	build/ria/tests/test_measurements
	build/ria/tests/test_expert
	build/ria/tests/test_state
	build/ria/tests/test_graph_contracts
	build/ria/tests/test_graph_prefill
	build/ria/tests/test_engine_prefill
	build/ria/tests/test_engine_startup
	build/ria/tests/test_api_policy
	build/ria/tests/test_tensor_metadata
	build/ria/tests/test_server_prefill
	build/ria/tests/test_probe_config
	build/ria/tests/test_admin
	build/ria/tests/test_server_contracts
	build/ria/tests/test_server_lifecycle
	RIA_TOKENIZER_BOUNDARY_FIXTURE=build/ria/tests/test_tokenizer_boundary $(RIA_PYTHON) -m pytest -q tests/ria
	ruff check tools tests/ria deploy

RIA_NATIVE_SRC = $(filter-out ria/qualify.c,$(sort $(wildcard ria/*.c)))
ria-static:
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -fsyntax-only $(RIA_NATIVE_SRC)
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -DRIA_QUALIFY_CPU_ONLY -fsyntax-only ria/qualify.c
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -DRIA_WITH_CUDA -fsyntax-only ria/server.c ria/expert_main.c ria/probe.c
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_DONOR_FLAGS) -fsyntax-only $(RIA_DONOR_SRC) ds4_cli.c ds4_server.c ds4_eval.c
	$(RIA_PYTHON) deploy/cppcheck_gate.py --output-dir build/ria/evidence

.PHONY: ria-sanitize
ria-sanitize:
	@mkdir -p build/ria/evidence build/ria/sanitize
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer tests/ria/test_contracts.c $(RIA_BASE_SRC) $(RIA_LDLIBS) -o build/ria/sanitize/contracts
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer tests/ria/test_expert.c ria/expert.c ria/common.c $(RIA_LDLIBS) -o build/ria/sanitize/expert
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer tests/ria/test_state.c ria/state.c ria/common.c $(RIA_LDLIBS) -o build/ria/sanitize/state
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -ffunction-sections tests/ria/test_graph_contracts.c ria/graph.c ria/vision.c ria/prefill.c ria/expert.c ria/common.c -Wl,--gc-sections $(RIA_LDLIBS) -lpng -ljpeg -o build/ria/sanitize/graph
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -ffunction-sections -fdata-sections tests/ria/test_engine_prefill.c ria/common.c -Wl,--gc-sections -lcrypto -lpthread -lm -o build/ria/sanitize/engine_prefill
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -ffunction-sections -fdata-sections $(RIA_ENGINE_STARTUP_FIXTURE_SRC) -Wl,--gc-sections -lcrypto -lpthread -lm -o build/ria/sanitize/engine_startup
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -Wno-unused-function -ffunction-sections -fdata-sections $(RIA_API_POLICY_FIXTURE_SRC) -Wl,--gc-sections -lcrypto -lpthread -lm -o build/ria/sanitize/api_policy
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -ffunction-sections -fdata-sections $(RIA_TENSOR_METADATA_FIXTURE_SRC) -Wl,--gc-sections -lcrypto -lnuma -lm -o build/ria/sanitize/tensor_metadata
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -ffunction-sections -fdata-sections $(RIA_TOKENIZER_BOUNDARY_FIXTURE_SRC) $(RIA_TOKENIZER_BOUNDARY_LDFLAGS) -o build/ria/sanitize/tokenizer_boundary
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -ffunction-sections tests/ria/test_server_prefill.c ria/expert.c ria/common.c -Wl,--gc-sections -lcrypto -lpthread -lm -o build/ria/sanitize/server_prefill
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -ffunction-sections tests/ria/test_graph_prefill.c ria/prefill.c ria/expert.c ria/common.c -Wl,--gc-sections -lcrypto -lm -o build/ria/sanitize/graph_prefill
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -ffunction-sections tests/ria/test_graph_step.c ria/common.c -Wl,--gc-sections -lcrypto -lm -o build/ria/sanitize/graph_step
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -ffunction-sections tests/ria/test_graph_cleanup.c ria/common.c -Wl,--gc-sections -lcrypto -lm -lpthread -o build/ria/sanitize/graph_cleanup
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer tests/ria/test_admin.c $(RIA_CORE_SRC) $(RIA_LDLIBS) -o build/ria/sanitize/admin
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer tests/ria/test_probe_config.c ria/probe.c ria/runtime.c $(RIA_BASE_SRC) $(RIA_LDLIBS) -o build/ria/sanitize/probe_config
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -ffunction-sections -fdata-sections $(RIA_FRONTEND_FIXTURE_SRC) -Wl,--gc-sections -lonig -lcrypto -lm -lpthread -o build/ria/sanitize/frontend
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer tests/ria/test_server_contracts.c ria/server.c ria/numa.c $(RIA_CORE_SRC) $(RIA_LDLIBS) -o build/ria/sanitize/server
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer tests/ria/test_server_lifecycle.c ria/numa.c $(RIA_CORE_SRC) $(RIA_LDLIBS) -o build/ria/sanitize/server_lifecycle
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer tests/ria/test_tensor.c $(RIA_CORE_SRC) $(RIA_LDLIBS) -o build/ria/sanitize/tensor
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer -DRIA_QUALIFY_CPU_ONLY ria/qualify.c ria/expert.c ria/common.c ria/json.c third_party/ryu/ryu/d2s.c $(RIA_LDLIBS) -o build/ria/sanitize/qualify
	$(RIA_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=address,undefined -fno-omit-frame-pointer ria/ctl.c ria/inventory.c ria/numa.c ria/probe.c ria/qualify_transport.c $(RIA_CORE_SRC) $(RIA_LDLIBS) -o build/ria/sanitize/ctl
	$(RIA_CC) $(RIA_CPPFLAGS) -O1 -g -std=c99 -Wall -Wextra -Werror -Wno-unused-function -fno-fast-math -ffp-contract=off -ffunction-sections -fdata-sections -fsanitize=address,undefined -fno-omit-frame-pointer tests/ria/test_measurements.c ria/common.c -Wl,--gc-sections -lm -lpthread -lcrypto -o build/ria/sanitize/measurements
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/measurements > build/ria/evidence/sanitize-measurements.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/contracts > build/ria/evidence/sanitize-contracts.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/expert > build/ria/evidence/sanitize-expert.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/state > build/ria/evidence/sanitize-state.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/graph > build/ria/evidence/sanitize-graph.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/engine_prefill > build/ria/evidence/sanitize-engine_prefill.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/engine_startup > build/ria/evidence/sanitize-engine_startup.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/api_policy > build/ria/evidence/sanitize-api_policy.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/tensor_metadata > build/ria/evidence/sanitize-tensor_metadata.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 RIA_TOKENIZER_BOUNDARY_FIXTURE=build/ria/sanitize/tokenizer_boundary $(RIA_PYTHON) -m pytest -q tests/ria/test_tokenizer_boundary.py > build/ria/evidence/sanitize-tokenizer_boundary.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/server_prefill > build/ria/evidence/sanitize-server_prefill.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/graph_prefill > build/ria/evidence/sanitize-graph_prefill.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/graph_step > build/ria/evidence/sanitize-graph_step.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/graph_cleanup > build/ria/evidence/sanitize-graph_cleanup.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/admin > build/ria/evidence/sanitize-admin.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/probe_config > build/ria/evidence/sanitize-probe_config.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/server > build/ria/evidence/sanitize-server.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 build/ria/sanitize/server_lifecycle > build/ria/evidence/sanitize-server_lifecycle.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 RIA_FRONTEND_FIXTURE=$(CURDIR)/build/ria/sanitize/frontend $(RIA_PYTHON) -m pytest -q tests/ria/test_encoding.py > build/ria/evidence/sanitize-frontend.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 RIA_TENSOR_FIXTURE=$(CURDIR)/build/ria/sanitize/tensor $(RIA_PYTHON) -m pytest -q tests/ria/test_native_artifacts.py > build/ria/evidence/sanitize-tensor.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 RIA_QUALIFY_FIXTURE=$(CURDIR)/build/ria/sanitize/qualify $(RIA_PYTHON) -m pytest -q tests/ria/test_qualify.py > build/ria/evidence/sanitize-qualify.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 RIA_TRANSPORT_FIXTURE=$(CURDIR)/build/ria/sanitize/ctl $(RIA_PYTHON) -m pytest -q tests/ria/test_transport_qualifier.py > build/ria/evidence/sanitize-transport.log 2>&1
	ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 RIA_CTL_FIXTURE=$(CURDIR)/build/ria/sanitize/ctl $(RIA_PYTHON) -m pytest -q tests/ria/test_inventory.py > build/ria/evidence/sanitize-inventory.log 2>&1

# LLVM 18 uses this same per-process ASLR policy when high-entropy mappings
# conflict with its shadow. Keep diagnostic binaries and policy out of serving.
build/ria/thread-sanitize/admin: tests/ria/test_admin.c $(RIA_CORE_SRC)
	@mkdir -p $(@D)
	$(RIA_THREAD_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=thread -fPIE -pie -fno-omit-frame-pointer -pthread $^ $(RIA_LDLIBS) -o $@

build/ria/thread-sanitize/server: tests/ria/test_server_contracts.c ria/server.c ria/numa.c $(RIA_CORE_SRC)
	@mkdir -p $(@D)
	$(RIA_THREAD_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=thread -fPIE -pie -fno-omit-frame-pointer -pthread $^ $(RIA_LDLIBS) -o $@

build/ria/thread-sanitize/server_lifecycle: tests/ria/test_server_lifecycle.c ria/server.c ria/numa.c $(RIA_CORE_SRC)
	@mkdir -p $(@D)
	$(RIA_THREAD_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=thread -fPIE -pie -fno-omit-frame-pointer -pthread $(filter-out ria/server.c,$^) $(RIA_LDLIBS) -o $@

build/ria/thread-sanitize/server_prefill: tests/ria/test_server_prefill.c ria/server.c ria/expert.c ria/common.c
	@mkdir -p $(@D)
	$(RIA_THREAD_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=thread -fPIE -pie -fno-omit-frame-pointer -pthread -ffunction-sections $(filter-out ria/server.c,$^) -Wl,--gc-sections -lcrypto -lpthread -lm -o $@

build/ria/thread-sanitize/api_policy: $(RIA_API_POLICY_FIXTURE_SRC) ds4_server.c ria/engine.h ds4.h
	@mkdir -p $(@D)
	$(RIA_THREAD_CC) $(RIA_CPPFLAGS) $(RIA_CFLAGS) -O1 -fsanitize=thread -fPIE -pie -fno-omit-frame-pointer -pthread -Wno-unused-function -ffunction-sections -fdata-sections $(RIA_API_POLICY_FIXTURE_SRC) -Wl,--gc-sections -lcrypto -lpthread -lm -o $@

.PHONY: ria-thread-sanitize
ria-thread-sanitize: build/ria/thread-sanitize/api_policy build/ria/thread-sanitize/server_prefill build/ria/thread-sanitize/admin build/ria/thread-sanitize/server build/ria/thread-sanitize/server_lifecycle
	@mkdir -p build/ria/evidence
	$(RIA_THREAD_CC) --version > build/ria/evidence/thread-sanitize-environment.log
	setarch --version >> build/ria/evidence/thread-sanitize-environment.log
	uname -m >> build/ria/evidence/thread-sanitize-environment.log
	TSAN_OPTIONS=halt_on_error=1:exitcode=66 timeout --signal=TERM --kill-after=5s 60s setarch -R build/ria/thread-sanitize/admin > build/ria/evidence/thread-sanitize-admin.log 2>&1
	TSAN_OPTIONS=halt_on_error=1:exitcode=66 timeout --signal=TERM --kill-after=5s 60s setarch -R build/ria/thread-sanitize/server > build/ria/evidence/thread-sanitize-server.log 2>&1
	TSAN_OPTIONS=halt_on_error=1:exitcode=66 timeout --signal=TERM --kill-after=5s 60s setarch -R build/ria/thread-sanitize/server_lifecycle > build/ria/evidence/thread-sanitize-server_lifecycle.log 2>&1
	TSAN_OPTIONS=halt_on_error=1:exitcode=66 timeout --signal=TERM --kill-after=5s 60s setarch -R build/ria/thread-sanitize/server_prefill > build/ria/evidence/thread-sanitize-server_prefill.log 2>&1
	TSAN_OPTIONS=halt_on_error=1:exitcode=66 timeout --signal=TERM --kill-after=5s 60s setarch -R build/ria/thread-sanitize/api_policy > build/ria/evidence/thread-sanitize-api_policy.log 2>&1

ria-clean:
	rm -rf build/ria
	rm -f bin/ds4ctl bin/ds4-expert-server bin/ds4-ria-qualify bin/cuda/ds4ctl bin/cuda/ds4-expert-server bin/cuda/ds4-server bin/cuda/ds4 bin/cuda/ds4-eval bin/cuda/ds4-ria-qualify

-include $(RIA_DEPS)
